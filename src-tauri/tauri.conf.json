{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novel Workbench",
  "version": "0.1.0",
  "identifier": "com.novelworkbench.app",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run client",
    "beforeBuildCommand": "npm run build:client"
  },
  "app": {
    "windows": [
      {
        "title": "Novel Workbench",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https: http: ws: wss: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
